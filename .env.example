# easy-agent-team 平台环境变量示例
# 复制为 .env 后填入真实值（.env 已被 .gitignore 排除，切勿提交；
# 平台自带的密钥扫描也会拦截被提交的含值 .env 文件，.env.example 除外）。
#
# 使用方式：
#   Docker:    docker run --env-file .env ...
#   本地直跑:  node --env-file=.env apps/server/dist/main.js  （Node 20.6+ 原生支持）

# ---- 必填 ----

# PostgreSQL 连接串（生产必须指向持久化实例）
DATABASE_URL=postgres://user:password@db-host:5432/eat

# 值加密主密钥：base64 编码的 32 字节，生成命令 openssl rand -base64 32
# ⚠ 丢失后所有密文（环境变量值、各类 Token）不可恢复，务必在密码管理器中备份
EAT_KEK=

# 平台对外访问地址（设备码授权页、webhook 链接以此拼接）
EAT_PUBLIC_URL=https://eat.example.com

# ---- 可选 ----

# 服务端口（默认 3000）
# PORT=3000

# 首次启动种子创建的管理员账号（默认 admin@example.com / admin12345，生产务必显式设置）
# EAT_ADMIN_EMAIL=admin@example.com
# EAT_ADMIN_PASSWORD=

# 设为 1 跳过启动时的种子步骤
# EAT_SKIP_SEED=0

# 每用户每小时求助上限（防骚扰，默认 10）
# EAT_HELP_RATE_LIMIT=10
